# systemd 서비스 유닛 (OCI/Ubuntu 서버 실배포 기준)
# 설치:
#   sudo cp cgv-seat-watch.service /etc/systemd/system/
#   (User / 경로 / venv 파이썬 경로를 본인 환경에 맞게 수정)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cgv-seat-watch
# 로그:   journalctl -u cgv-seat-watch -f
# 중지:   sudo systemctl stop cgv-seat-watch
#
# 전제: 데이터센터 IP는 Cloudflare가 차단하므로 WARP 프록시 모드가 켜져 있어야 함
#       (README 참고). .env 에 CGV_PROXY=socks5://127.0.0.1:40000 설정.

[Unit]
Description=CGV seat availability watcher (API, no Selenium)
After=network-online.target warp-svc.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/yong_imax_notify_bot/api_watcher
EnvironmentFile=/home/ubuntu/yong_imax_notify_bot/api_watcher/.env
# 부팅 시 WARP 프록시가 준비될 시간 확보 (프록시 안 쓰면 이 줄 삭제 가능)
ExecStartPre=/bin/sh -c "warp-cli --accept-tos connect 2>/dev/null || true; sleep 4"
ExecStart=/home/ubuntu/yong_imax_notify_bot/api_watcher/.venv/bin/python /home/ubuntu/yong_imax_notify_bot/api_watcher/cgv_seat_watch.py
# 상영 시각이 지나 정상 종료(exit 0)하면 재시작하지 않음.
# 네트워크/크래시 등 비정상 종료(exit!=0)일 때만 자동 재시작.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
