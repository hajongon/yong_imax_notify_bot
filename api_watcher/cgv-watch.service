# systemd 서비스 유닛 — 무중단 다중 타겟 감시 (OCI/Ubuntu 기준)
#
# 설치:
#   sudo cp cgv-watch.service /etc/systemd/system/
#   (User / 경로 / venv 파이썬 경로를 본인 환경에 맞게 수정)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cgv-watch
# 로그:   journalctl -u cgv-watch -f
# 중지:   sudo systemctl stop cgv-watch
#
# 전제: 데이터센터 IP는 Cloudflare가 차단하므로 WARP 프록시 모드 필요(README 참고).
#       targets.yaml 의 proxy 또는 .env 의 CGV_PROXY 에 socks5://127.0.0.1:40000 설정.

[Unit]
Description=CGV seat/open watcher (API, multi-target, no Selenium)
After=network-online.target warp-svc.service
Wants=network-online.target
# 재시작 횟수 제한 해제 — 몇 번을 죽든 계속 되살림(무중단).
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/yong_imax_notify_bot/api_watcher
EnvironmentFile=/home/ubuntu/yong_imax_notify_bot/api_watcher/.env
# 부팅 시 WARP 프록시 준비 대기(프록시 안 쓰면 삭제 가능)
ExecStartPre=/bin/sh -c "warp-cli --accept-tos connect 2>/dev/null || true; sleep 4"
ExecStart=/home/ubuntu/yong_imax_notify_bot/api_watcher/.venv/bin/python /home/ubuntu/yong_imax_notify_bot/api_watcher/run.py

# --- 무중단 설정 ---
# 프로세스는 시그널 전까지 스스로 종료하지 않음(개별 타겟이 끝나도 유지).
# 크래시/재부팅/OOM 등 어떤 비정상 종료든 항상 재시작.
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
