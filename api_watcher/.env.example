# 비밀값 전용. (감시 대상/좌석범위 등은 targets.yaml 에서 설정)
#   cp .env.example .env  후 값 채우기. .env 는 git 에 올라가지 않음.

# ===== 텔레그램 (필수) =====
TELEGRAM_BOT_TOKEN=여기에_봇토큰_붙여넣기
TELEGRAM_CHAT_ID=-1003872445177

# ===== 네트워크 (선택) =====
# Cloudflare가 데이터센터 IP(예: OCI)를 차단할 때 프록시로 우회.
# Cloudflare WARP 프록시 모드: socks5://127.0.0.1:40000
# 집/노트북(가정용 IP)에서 돌리면 비워두거나 생략.
# (targets.yaml 의 defaults.proxy 로도 지정 가능. 환경변수가 우선.)
CGV_PROXY=socks5://127.0.0.1:40000
